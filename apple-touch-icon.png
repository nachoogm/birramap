#!/usr/bin/env bash
# BirraMap - despliegue completo en Azure (coste ~0€)
# Uso: bash infra/deploy.sh
set -euo pipefail

RG="rg-birramap"
LOC="westeurope"
SA="stbirramap$RANDOM"          # nombre global único
SWA="swa-birramap"
REPO="https://github.com/TU_USUARIO/birra-map"   # <-- cambia esto

az group create -n $RG -l $LOC -o none

# Storage (Tables) - Standard LRS, lo más barato
az storage account create -n $SA -g $RG -l $LOC --sku Standard_LRS --kind StorageV2 --min-tls-version TLS1_2 --allow-blob-public-access false -o none

CONN=$(az storage account show-connection-string -n $SA -g $RG --query connectionString -o tsv)

# Static Web App (plan Free) enlazada al repo de GitHub
az staticwebapp create -n $SWA -g $RG -l $LOC --sku Free --source $REPO --branch main --app-location "/public" --api-location "/api" --output-location "" --login-with-github -o none

# Variables de entorno de la API
az staticwebapp appsettings set -n $SWA -g $RG --setting-names \
  STORAGE_CONNECTION_STRING="$CONN" PURGE_KEY="$(openssl rand -hex 16)" RETENTION_DAYS="180" -o none

echo "✅ Listo: https://$(az staticwebapp show -n $SWA -g $RG --query defaultHostname -o tsv)"
echo "   Storage: $SA"
