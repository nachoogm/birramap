:root{
  --bg:#0b1b3a; --bg2:#0f2450; --card:#132a55; --line:#22407a;
  --gold:#f5b301; --gold2:#ffd24a; --txt:#eaf0ff; --mut:#93a7cf;
  --ok:#39d98a; --bad:#ff5f6d;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--txt);overscroll-behavior:none}
.hidden{display:none!important}
.screen{height:100dvh;width:100%}
.mini{font-size:.74rem;color:var(--mut);font-weight:400}

/* LOGIN / ONBOARDING */
#login,#onboarding{display:flex;align-items:center;justify-content:center;
  background:radial-gradient(1000px 600px at 50% 0%,#1b3a72 0%,var(--bg) 60%)}
.login-card{width:min(380px,90vw);background:var(--card);border:1px solid var(--line);
  border-radius:20px;padding:26px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.45)}
.login-card .logo{width:84px;border-radius:20px;margin-bottom:8px}
.login-card h1{margin:.2rem 0;font-size:1.9rem;letter-spacing:-.5px}
.login-card h2{margin:.2rem 0 1rem;font-size:1.4rem}
.tag{color:var(--mut);margin:0 0 20px}
label{display:block;text-align:left;font-size:.8rem;color:var(--mut);margin:12px 0 4px;font-weight:600}
input{width:100%;padding:12px;border-radius:12px;border:1px solid var(--line);
  background:#0e2049;color:var(--txt);font-size:1rem;outline:none}
input:focus{border-color:var(--gold)}

.btn{display:block;width:100%;padding:13px;margin-top:10px;border-radius:12px;border:1px solid var(--line);
  background:#0e2049;color:var(--txt);font-size:1rem;font-weight:600;cursor:pointer;text-decoration:none}
.btn:active{transform:scale(.98)}
.btn-primary{background:linear-gradient(180deg,var(--gold2),var(--gold));color:#26180a;border:none}
.btn-gh{background:#1f2937}
.btn-aad{background:#1e5aa8}
.btn-ghost{background:transparent}

/* TOPBAR */
.topbar{position:fixed;top:0;left:0;right:0;height:56px;z-index:600;display:flex;align-items:center;
  justify-content:space-between;padding:0 12px;padding-top:env(safe-area-inset-top);
  background:linear-gradient(180deg,rgba(11,27,58,.96),rgba(11,27,58,.6));backdrop-filter:blur(8px)}
.brand{display:flex;align-items:center;gap:8px;font-weight:700}
.brand img{width:30px;border-radius:8px}
.topright{display:flex;align-items:center;gap:8px}
.chip{background:var(--card);border:1px solid var(--line);padding:5px 10px;border-radius:999px;font-size:.75rem;color:var(--mut)}
.icon-btn{background:var(--card);border:1px solid var(--line);color:var(--txt);width:36px;height:36px;
  border-radius:10px;font-size:1.1rem;cursor:pointer}

/* MAPA */
#map{position:absolute;inset:0;z-index:1;background:#0a1428}
.leaflet-container{background:#0a1428}
.leaflet-tile{filter:brightness(.75) saturate(.85) hue-rotate(185deg) contrast(1.05)}
.pin{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;
  background:var(--card);border:2px solid var(--gold);font-size:20px;box-shadow:0 4px 14px rgba(0,0,0,.5)}
.pin small{position:absolute;bottom:-4px;right:-4px;background:var(--gold);color:#26180a;
  border-radius:999px;padding:1px 6px;font-size:11px;font-weight:800}
.pin.stale{border-color:var(--line);opacity:.55}
.pop{font-size:.85rem;color:#0b1b3a}
.pop b{display:block;font-size:1rem}

/* SHEET */
.sheet{position:fixed;left:0;right:0;bottom:0;z-index:600;max-height:62dvh;transform:translateY(calc(100% - 132px));
  transition:transform .25s ease;background:var(--bg2);border-top:1px solid var(--line);
  border-radius:20px 20px 0 0;padding:6px 12px 90px;overflow-y:auto}
.sheet.open{transform:translateY(0)}
.sheet-handle{width:44px;height:5px;background:var(--line);border-radius:9px;margin:6px auto 10px;cursor:grab}
.tabs{display:flex;gap:6px;margin-bottom:10px}
.tab{flex:1;padding:9px;border-radius:10px;border:1px solid var(--line);background:transparent;
  color:var(--mut);font-size:.82rem;font-weight:600;cursor:pointer}
.tab.active{background:var(--card);color:var(--txt);border-color:var(--gold)}
.seg{display:flex;gap:6px;margin-bottom:10px}
.seg-btn{flex:1;padding:7px;border-radius:9px;border:1px solid var(--line);background:transparent;color:var(--mut);font-size:.78rem;cursor:pointer}
.seg-btn.active{background:var(--card);color:var(--gold)}

.row{display:flex;align-items:center;gap:10px;padding:10px;border-radius:12px;background:var(--card);
  border:1px solid var(--line);margin-bottom:8px;cursor:pointer}
.row:active{border-color:var(--gold)}
.row .em{font-size:1.5rem}
.row .who{flex:1;min-width:0}
.row .who b{display:block;font-size:.95rem}
.row .who span{font-size:.76rem;color:var(--mut);display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row .cnt{font-weight:800;color:var(--gold);font-size:1.15rem}
.medal{width:26px;text-align:center;font-size:1.1rem}
.empty{text-align:center;color:var(--mut);padding:24px 10px;font-size:.9rem}
.stat{display:flex;justify-content:space-between;padding:9px 2px;border-bottom:1px dashed var(--line);font-size:.9rem}
.stat span{color:var(--mut)}

/* FAB */
.fab{position:fixed;right:16px;bottom:calc(148px + env(safe-area-inset-bottom));z-index:700;
  display:flex;align-items:center;gap:8px;padding:14px 20px;border:none;border-radius:999px;
  background:linear-gradient(180deg,var(--gold2),var(--gold));color:#26180a;font-weight:800;font-size:1rem;
  box-shadow:0 10px 26px rgba(245,179,1,.35);cursor:pointer}
.fab:active{transform:scale(.96)}

/* MODAL */
.modal{position:fixed;inset:0;z-index:900;background:rgba(4,10,24,.75);display:flex;align-items:flex-end;justify-content:center}
.modal-card{width:min(440px,100%);background:var(--bg2);border:1px solid var(--line);border-radius:20px 20px 0 0;
  padding:20px 18px calc(24px + env(safe-area-inset-bottom));max-height:92dvh;overflow-y:auto}
@media(min-width:600px){.modal{align-items:center}.modal-card{border-radius:20px}}
.modal-card h3{margin:0 0 12px}
.drinks{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.drink{padding:10px 4px;border-radius:12px;border:1px solid var(--line);background:var(--card);
  text-align:center;cursor:pointer;font-size:.66rem;color:var(--mut)}
.drink b{display:block;font-size:1.5rem;margin-bottom:2px}
.drink.sel{border-color:var(--gold);background:#20376b;color:var(--txt)}
.qty{display:flex;align-items:center;justify-content:center;gap:20px;margin-top:6px}
.qty-btn{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:var(--card);
  color:var(--txt);font-size:1.4rem;cursor:pointer}
#qtyVal{font-size:1.7rem;font-weight:800;min-width:40px;text-align:center;color:var(--gold)}
.modal-actions{display:flex;gap:10px;margin-top:18px}
.modal-actions .btn{margin-top:0}

.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(210px + env(safe-area-inset-bottom));
  z-index:1000;background:var(--card);border:1px solid var(--gold);padding:11px 18px;border-radius:999px;
  font-size:.88rem;box-shadow:0 8px 24px rgba(0,0,0,.5)}
